{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "URL shortener with Fastify, MongoDB, Redis and Hashids (base62)",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "24.x"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "download",
      "version": "12.5.1"
    }
  },
  "packageManager": "pnpm@12.5.1",
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/swagger": "9.8.2",
    "@scalar/fastify-api-reference": "1.70.0",
    "dotenv": "18.0.2",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "hashids": "2.3.0",
    "ioredis": "6.0.0",
    "mongodb": "7.6.0",
    "sst": "4.17.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.163",
    "@types/node": "24.13.6",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
